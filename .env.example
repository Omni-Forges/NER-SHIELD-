# Copy this file to .env and adjust if needed.
# These defaults match docker-compose.yml, so local dev works out of the box.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih26002

# Open-Meteo needs no API key — this is just the base URL, included so it's
# easy to swap in a different weather provider later without touching code.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# Northeast India bounding box, used to validate that incoming coordinates
# actually fall within the region this platform covers.
NER_MIN_LAT=21.5
NER_MAX_LAT=29.5
NER_MIN_LON=88.0
NER_MAX_LON=97.5
